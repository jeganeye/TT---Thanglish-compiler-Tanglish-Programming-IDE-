# Function to convert Python file to Tanglish
def convert_python_to_tanglish(python_file, output_file=None):
    try:
        with open(python_file, 'r', encoding='utf-8') as f:
            python_code = f.read()
        
        # Reverse translation
        tanglish_code = python_code
        
        # Sort keywords by length (descending) to avoid partial replacements
        sorted_keywords = sorted(KEYWORDS.items(), key=lambda x: len(x[1]), reverse=True)
        
        for tanglish, python in sorted_keywords:
            # Use word boundaries to ensure we're replacing whole words
            tanglish_code = re.sub(rf'\b{python}\b', tanglish, tanglish_code)
        
        if output_file:
            with open(output_file, 'w', encoding='utf-8') as f:
                f.write(tanglish_code)
            return f"Successfully converted Python to Tanglish and saved to {output_file}"
        else:
            return tanglish_code
    except Exception as e:
        return f"Error during conversion: {str(e)}"

