# Function to translate Tanglish code to Python
def translate_tanglish_to_python(tanglish_code):
    for tanglish, python in KEYWORDS.items():
        tanglish_code = re.sub(rf'\b{tanglish}\b', python, tanglish_code)
    return tanglish_code

# Function to translate Python error messages to Tamil
def translate_error(error):
    error_type = type(error).__name__
    error_msg = str(error)
    
    # Translate error type
    tamil_error_type = ERROR_MESSAGES.get(error_type, error_type)
    
    # Try to translate keywords in the error message
    for py_word, tam_word in PYTHON_TO_TANGLISH.items():
        error_msg = error_msg.replace(f"'{py_word}'", f"'{tam_word}'")
    
    return f"{tamil_error_type}: {error_msg}"

# Function to execute Tanglish code
def execute_tanglish_code(tanglish_code, debug=False):
    python_code = translate_tanglish_to_python(tanglish_code)
    if debug:
        print("Debug: Translated Python Code:\n", python_code)
    
    try:
        result = eval(python_code, global_namespace)
        return result
    except SyntaxError:
        try:
            exec(python_code, global_namespace)
            return None
        except Exception as e:
            return translate_error(e)
    except Exception as e:
        return translate_error(e)

def debug_tanglish_code(tanglish_code):
    """Execute Tanglish code in debug mode with step-by-step execution"""
    lines = tanglish_code.strip().split('\n')
    python_lines = [translate_tanglish_to_python(line) for line in lines]
    
    print("=== Debug Mode ===")
    print("Press Enter to execute next line, 'q' to quit, 'v' to view variables")
    
    local_vars = {}
    
    for i, (tanglish_line, python_line) in enumerate(zip(lines, python_lines)):
        if not tanglish_line.strip():
            continue
            
        print(f"\nLine {i+1}: {tanglish_line}")
        cmd = input("Command [Enter/q/v]: ").strip().lower()
        
        if cmd == 'q':
            print("Debug session ended.")
            break
        elif cmd == 'v':
            print("Current variables:")
            for name, value in global_namespace.items():
                if not name.startswith('__') and name not in globals():
                    print(f"  {name} = {value}")
            # Continue with the same line
            i -= 1
            continue
        
        try:
            result = execute_tanglish_code(tanglish_line)
            if result is not None:
                print(f"Result: {result}")
        except Exception as e:
            print(f"Error: {translate_error(e)}")
            break
    
    return "Debug session completed."

# Function to format Tanglish code
def format_tanglish_code(code):
    """Format Tanglish code for better readability"""
    # Basic indentation fixing
    lines = code.split('\n')
    formatted_lines = []
    indent_level = 0
    
    for line in lines:
        stripped = line.strip()
        
        # Decrease indent for closing blocks
        if any(stripped.startswith(word) for word in ["illana:", "illainu:", "mudikirathu:"]):
            indent_level = max(0, indent_level - 1)
        
        # Add proper indentation
        formatted_lines.append("    " * indent_level + stripped)
        
        # Increase indent for opening blocks
        if any(word in stripped for word in ["enna ", "neram ", "payan ", "varu ", "sirandha ", "sindhanaiselutham:"]):
            if stripped.endswith(':'):
                indent_level += 1
    
    return '\n'.join(formatted_lines)

# Simple Tamil code editor with syntax highlighting
def simple_editor():
    """A simple Tamil code editor using the terminal"""
    try:
        import curses
        
        def main_editor(stdscr):
            curses.start_color()
            curses.init_pair(1, curses.COLOR_GREEN, curses.COLOR_BLACK)  # Keywords
            curses.init_pair(2, curses.COLOR_CYAN, curses.COLOR_BLACK)   # Strings
            curses.init_pair(3, curses.COLOR_YELLOW, curses.COLOR_BLACK) # Numbers
            
            # Initialize editor state
            lines = [""]
            current_line = 0
            current_col = 0
            
            # Main editor loop
            while True:
                stdscr.clear()
                height, width = stdscr.getmaxyx()
                
                # Display file content with syntax highlighting
                for i, line in enumerate(lines):
                    if i >= height - 1:
                        break
                    
                    # Basic syntax highlighting
                    j = 0
                    while j < len(line):
                        if j >= width - 1:
                            break
                            
                        # Check for keywords
                        keyword_match = False
                        for keyword in KEYWORDS:
                            if line[j:].startswith(keyword) and (j == 0 or not line[j-1].isalnum()):
                                stdscr.attron(curses.color_pair(1))
                                stdscr.addstr(i, j, keyword)
                                stdscr.attroff(curses.color_pair(1))
                                j += len(keyword)
                                keyword_match = True
                                break
                        
                        if keyword_match:
                            continue
                            
                        # Check for strings
                        if line[j:j+1] in ['"', "'"]:
                            quote = line[j:j+1]
                            end_quote = line[j+1:].find(quote)
                            if end_quote != -1:
                                stdscr.attron(curses.color_pair(2))
                                stdscr.addstr(i, j, line[j:j+end_quote+2])
                                stdscr.attroff(curses.color_pair(2))
                                j += end_quote + 2
                                continue
                        
                        # Check for numbers
                        if line[j:j+1].isdigit():
                            num_len = 0
                            while j + num_len < len(line) and (line[j+num_len].isdigit() or line[j+num_len] == '.'):
                                num_len += 1
                            stdscr.attron(curses.color_pair(3))
                            stdscr.addstr(i, j, line[j:j+num_len])
                            stdscr.attroff(curses.color_pair(3))
                            j += num_len
                            continue
                        
                        # Regular character
                        stdscr.addstr(i, j, line[j])
                        j += 1
                
                # Position cursor
                stdscr.move(current_line, current_col)
                
                # Get user input
                key = stdscr.getch()
                
                # Handle key presses
                if key == 27:  # ESC key
                    break
                elif key == curses.KEY_UP:
                    current_line = max(0, current_line - 1)
                    current_col = min(current_col, len(lines[current_line]))
                elif key == curses.KEY_DOWN:
                    current_line = min(len(lines) - 1, current_line + 1)
                    current_col = min(current_col, len(lines[current_line]))
                elif key == curses.KEY_LEFT:
                    if current_col > 0:
                        current_col -= 1
                    elif current_line > 0:
                        current_line -= 1
                        current_col = len(lines[current_line])
                elif key == curses.KEY_RIGHT:
                    if current_col < len(lines[current_line]):
                        current_col += 1
                    elif current_line < len(lines) - 1:
                        current_line += 1
                        current_col = 0
                elif key == 10:  # Enter key
                    lines.insert(current_line + 1, lines[current_line][current_col:])
                    lines[current_line] = lines[current_line][:current_col]
                    current_line += 1
                    current_col = 0
                elif key == 8 or key == 127:  # Backspace
                    if current_col > 0:
                        lines[current_line] = lines[current_line][:current_col-1] + lines[current_line][current_col:]
                        current_col -= 1
                    elif current_line > 0:
                        current_col = len(lines[current_line - 1])
                        lines[current_line - 1] += lines[current_line]
                        lines.pop(current_line)
                        current_line -= 1
                elif key == 9:  # Tab key
                    lines[current_line] = lines[current_line][:current_col] + "    " + lines[current_line][current_col:]
                    current_col += 4
                elif 32 <= key <= 126:  # Printable characters
                    lines[current_line] = lines[current_line][:current_col] + chr(key) + lines[current_line][current_col:]
                    current_col += 1
                
                # Handle special commands (Ctrl+S to save, Ctrl+R to run)
                elif key == 19:  # Ctrl+S
                    filename = "temp_code.tn"
                    with open(filename, "w") as f:
                        f.write("\n".join(lines))
                    stdscr.addstr(height-1, 0, f"Saved to {filename}")
                    stdscr.refresh()
                    curses.napms(1000)
                elif key == 18:  # Ctrl+R
                    code = "\n".join(lines)
                    stdscr.clear()
                    stdscr.addstr(0, 0, "Running code... Press any key to return to editor")
                    stdscr.refresh()
                    
                    # Save current terminal state
                    curses.endwin()
                    
                    # Run the code
                    print("\n--- Code Output ---")
                    execute_tanglish_code(code)
                    print("\n--- End Output ---")
                    input("Press Enter to return to editor...")
                    
                    # Restore terminal state
                    stdscr.refresh()
            
            return "\n".join(lines)
        
        code = curses.wrapper(main_editor)
        return code
    
    except ImportError:
        print("Curses library not available. Simple editor cannot be started.")
        return None

